{
	"name": "kjeks",
	"version": "1.0.6",
	"description": "Cookie consent management for WordPress Multisite.",
	"license": "GPL-2.0-or-later",
	"private": true,
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style",
		"format": "wp-scripts format",
		"i18n": "npm run i18n:make-pot && npm run i18n:update-po && npm run i18n:make-mo && npm run i18n:make-json && npm run i18n:make-php",
		"i18n:make-pot": "wp i18n make-pot . languages/kjeks.pot --exclude=node_modules,vendor,tests,build --domain=kjeks",
		"i18n:update-po": "wp i18n update-po languages/kjeks.pot languages/",
		"i18n:make-mo": "wp i18n make-mo languages/ languages/",
		"i18n:make-json": "wp i18n make-json languages/ --no-purge --use-map=i18n-map.json",
		"i18n:make-php": "wp i18n make-php languages/ languages/"
	},
	"devDependencies": {
		"@wordpress/scripts": "^30.0.0"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^7.0.0",
		"@wordpress/components": "^29.0.0",
		"@wordpress/element": "^6.0.0",
		"@wordpress/i18n": "^5.0.0"
	}
}
